# Get a token from @BotFather and replace this value locally.
BOT_TOKEN=replace_with_your_bot_token

# Optional. Docker Compose uses its own fixed paths for the database and images.
# DB_PATH=./data/bot.sqlite3
# KITTEN_DIR=./assets/kittens
LOG_LEVEL=INFO

# Seconds for each network operation (5..120). Polling adds 30 seconds to the read timeout.
TELEGRAM_TIMEOUT=30

# Optional HTTP CONNECT proxy if this server cannot reach Telegram directly.
# HTTPS_PROXY=http://proxy.example:3128
