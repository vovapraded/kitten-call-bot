# Get a token from @BotFather and replace this value locally.
BOT_TOKEN=replace_with_your_bot_token

# Optional. Docker Compose uses its own fixed paths for the database and images.
# DB_PATH=./data/bot.sqlite3
# KITTEN_DIR=./assets/kittens
LOG_LEVEL=INFO

# Seconds for each network operation (5..120). Polling adds 30 seconds to the read timeout.
TELEGRAM_TIMEOUT=30

# Proxy for all Telegram calls, including polling, photo uploads and diagnostics.
# Uncomment ONE example, replace it with your own reachable proxy, keep quotes.
# TELEGRAM_PROXY_URL='socks5://USER:PASSWORD@proxy.example:1080'
# TELEGRAM_PROXY_URL='http://USER:PASSWORD@proxy.example:3128'
# Without authentication: TELEGRAM_PROXY_URL='socks5://proxy.example:1080'
# Special characters in USER/PASSWORD must be URL-encoded (@ -> %40, # -> %23).
# HTTP, HTTPS, SOCKS5 and SOCKS5H are supported; Telegram MTProto proxies are not.
# Legacy HTTPS_PROXY is still accepted when TELEGRAM_PROXY_URL is empty.
